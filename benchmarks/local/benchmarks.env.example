# Copy to benchmarks/local/benchmarks.env and adjust paths.
# Load automatically via run_benchmarks.sh (or: export LLMEMORY_BENCH_ENV=/path/to/benchmarks.env)

# LM Studio
LLMEMORY_BENCH_PROFILE=default
LLMEMORY_LLM_BASE_URL=http://127.0.0.1:1234/v1
LLMEMORY_LLM_MODEL=qwen2.5-7b-instruct
LLMEMORY_LLM_API_KEY=lm-studio
LLMEMORY_LLM_TIMEOUT=600
LLMEMORY_LLM_HTTP_RETRIES=4

# Datasets (clone official repos / HF exports locally)
# LOCOMO_DATASET_ROOT=/home/you/data/locomo
# LONGMEMEVAL_DATASET_ROOT=/home/you/data/LongMemEval/data
# LONGMEMEVAL_SPLIT=oracle
# MEMORYAGENTBENCH_DATASET_ROOT=/home/you/data/MemoryAgentBench
# MEMORYAGENTBENCH_SUBSET=Accurate_Retrieval
# LOCOMO_PLUS_DATASET_ROOT=/home/you/data/Locomo-Plus
# MEMSYCO_DATASET_ROOT=/home/you/data/MemSyco-Bench
# MEMSYCO_TASK=personalized_memory_use
# GROUPMEMBENCH_DATASET_ROOT=/home/you/data/GroupMemBench
# GROUPMEMBENCH_DOMAIN=Finance
# GROUPMEMBENCH_QTYPE=multi_hop
# MEM2ACT_DATASET_ROOT=/home/you/data/Mem2ActBench
# MEMORYARENA_DATASET_ROOT=/home/you/data/memoryarena
# MEMORYARENA_CONFIG=bundled_shopping
